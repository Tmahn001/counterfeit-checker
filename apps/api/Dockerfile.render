# syntax=docker/dockerfile:1.7
# Render image: Django API + Celery worker (with TensorFlow) in one container. Build context = repo root.
# Mirrors the `worker` stage of apps/api/Dockerfile plus the production bits of the `prod` stage.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10 TF_CPP_MIN_LOG_LEVEL=2 ML_ARTIFACTS_DIR=/ml/artifacts
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 libgl1 libglib2.0-0 curl \
  && rm -rf /var/lib/apt/lists/*

# ML dependencies (TensorFlow is large): rebuilt only when ml/pyproject.toml changes.
COPY ml/pyproject.toml ml/README.md /ml/
RUN python -c "import tomllib; print(chr(10).join(tomllib.load(open('/ml/pyproject.toml','rb'))['project']['dependencies']))" > /tmp/ml-requirements.txt \
  && pip install -r /tmp/ml-requirements.txt
COPY apps/api/requirements/base.txt /tmp/requirements/base.txt
RUN pip install -r /tmp/requirements/base.txt
COPY ml/src /ml/src
RUN pip install --no-deps /ml
# The Keras embedding checkpoint the worker signs OEM reference sets with (versioned, ~1 MB).
COPY ml/artifacts /ml/artifacts

COPY apps/api/ /app/
# Static files are collected at build time; the settings need placeholder values to import.
RUN DJANGO_SETTINGS_MODULE=config.settings.prod DJANGO_SECRET_KEY=build-only \
    DATABASE_URL=sqlite:////tmp/build.db REDIS_URL=redis://build-only:6379/0 python manage.py collectstatic --noinput \
  && addgroup --system app && adduser --system --ingroup app app \
  && mkdir -p /app/media && chown -R app:app /app && chmod +x /app/bin/start-render.sh
USER app
CMD ["/app/bin/start-render.sh"]
