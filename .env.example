# Copied to .env by scripts/setup.sh. Consumed by docker compose (infra/docker-compose.yml).

# --- Postgres ---
POSTGRES_DB=authentic_edge
POSTGRES_USER=authentic_edge
POSTGRES_PASSWORD=authentic_edge_dev_only

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me-in-any-real-deployment
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx
DATABASE_URL=postgres://authentic_edge:authentic_edge_dev_only@db:5432/authentic_edge
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://localhost
PUBLIC_WEB_ORIGIN=http://localhost:3000
SENTRY_DSN=
# Seeded on first `docker compose up` (dev only)
DEV_SUPERUSER_EMAIL=admin@example.com
DEV_SUPERUSER_PASSWORD=admin12345
DEV_OEM_EMAIL=oem@example.com
DEV_OEM_PASSWORD=oem12345
DEV_NAFDAC_EMAIL=nafdac@example.com
DEV_NAFDAC_PASSWORD=nafdac12345

# --- Web (Next.js) ---
# Leave empty: same-origin via nginx (prod and `make https`); the bare dev server on :3000 uses :8000 directly.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MODEL_MANIFEST_URL=/models/v1/model.json
NEXT_PUBLIC_BASELINES_URL=/baselines/v1/baselines.json
NEXT_PUBLIC_SENTRY_DSN=
